{
  "name": "fontcraft",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:web": "vite build --mode web",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "verify:web": "node scripts/verify.mjs web",
    "verify:android": "node scripts/verify.mjs android",
    "e2e": "node e2e/editor.e2e.mjs && node e2e/scan.e2e.mjs",
    "e2e:editor": "node e2e/editor.e2e.mjs",
    "e2e:scan": "node e2e/scan.e2e.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7"
  }
}
